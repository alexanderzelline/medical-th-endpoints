meta {
  name: Obtener token
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/token/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "admin",
    "password": "admin"
  }
}

script:after-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.token);
  }
}
